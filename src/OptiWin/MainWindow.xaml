<Window x:Class="OptiWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OptiWin" Width="1120" Height="760" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        Icon="Assets/icon.ico">
    <Grid Background="{StaticResource BgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barre latérale -->
        <Border Grid.RowSpan="2" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,24,0,26">
                    <Border Width="34" Height="34" CornerRadius="9">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4F8CFF" Offset="0"/>
                                <GradientStop Color="#8B5CF6" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="OptiWin" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock x:Name="VersionText" Text="v1.0.0" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,14">
                    <Border x:Name="UpdateBanner" Visibility="Collapsed" Background="#1F2A44" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Mise à jour disponible" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock x:Name="UpdateText" Style="{StaticResource Muted}" Margin="0,2,0,8"/>
                            <Button Content="Télécharger" Style="{StaticResource PrimaryButton}" Padding="10,6" Click="Update_Click"/>
                        </StackPanel>
                    </Border>
                    <Button Content="Projet GitHub" Style="{StaticResource SecondaryButton}" Padding="10,7" FontSize="12.5" Click="Github_Click"/>
                </StackPanel>

                <StackPanel>
                    <RadioButton x:Name="NavDashboard" Style="{StaticResource NavItem}" Tag="&#xE80F;" Content="Tableau de bord" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavCleanup" Style="{StaticResource NavItem}" Tag="&#xE74D;" Content="Nettoyage" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavTweaks" Style="{StaticResource NavItem}" Tag="&#xE945;" Content="Optimisations" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavStartup" Style="{StaticResource NavItem}" Tag="&#xE7E8;" Content="Démarrage" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavTools" Style="{StaticResource NavItem}" Tag="&#xE90F;" Content="Outils" Checked="Nav_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Contenu -->
        <ContentControl x:Name="Host" Grid.Column="1"/>

        <!-- Barre d'état -->
        <Border Grid.Column="1" Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE946;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource MutedBrush}"
                           FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="StatusText" Text="Prêt." Foreground="{StaticResource MutedBrush}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
