<UserControl x:Class="OptiWin.Pages.CleanupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="34,30,34,20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Nettoyage" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Libérez de l'espace disque en supprimant les fichiers inutiles. Vos documents personnels ne sont jamais touchés." Style="{StaticResource PageSubtitle}"/>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Espace récupérable (sélection)" Style="{StaticResource Muted}"/>
                        <TextBlock x:Name="TotalText" Text="Cliquez sur Analyser" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ScanButton" Content="Analyser" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="Scan_Click"/>
                        <Button x:Name="CleanButton" Content="Nettoyer" Style="{StaticResource PrimaryButton}" Click="Clean_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            <ProgressBar x:Name="Progress" IsIndeterminate="True" Height="4" Margin="0,0,0,14" Visibility="Collapsed"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="List">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Style="{StaticResource Check}" IsChecked="{Binding IsSelected}" VerticalAlignment="Center"
                                          Margin="0,0,16,0" Click="Selection_Changed"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="16,0,0,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
