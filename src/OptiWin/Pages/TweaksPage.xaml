<UserControl x:Class="OptiWin.Pages.TweaksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="TweakTemplate">
            <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,20,0">
                        <WrapPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,10,0"/>
                            <Border Background="#1E3A2C" CornerRadius="5" Padding="7,1" Margin="0,0,6,0"
                                    Visibility="{Binding Recommended, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Recommandé" FontSize="11" Foreground="{StaticResource SuccessBrush}"/>
                            </Border>
                            <Border Background="#3A2F1A" CornerRadius="5" Padding="7,1"
                                    Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding Badge}" FontSize="11" Foreground="{StaticResource WarningBrush}"/>
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                              IsChecked="{Binding IsApplied, Mode=OneWay}" IsEnabled="{Binding IsIdle}" Click="Toggle_Click"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="34,30,34,20">
        <StackPanel DockPanel.Dock="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Optimisations" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Chaque réglage est réversible : désactivez l'interrupteur pour revenir au réglage Windows d'origine." Style="{StaticResource PageSubtitle}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,0,0">
                    <Button x:Name="RestoreButton" Content="Point de restauration" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="Restore_Click"/>
                    <Button x:Name="RecommendedButton" Content="Appliquer les recommandés" Style="{StaticResource PrimaryButton}" Click="Recommended_Click"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Sections"/>
        </ScrollViewer>
    </DockPanel>
</UserControl>
