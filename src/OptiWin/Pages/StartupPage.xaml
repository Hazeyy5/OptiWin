<UserControl x:Class="OptiWin.Pages.StartupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="34,30,34,20">
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Démarrage" Style="{StaticResource PageTitle}"/>
                <TextBlock x:Name="Subtitle" Style="{StaticResource PageSubtitle}"
                           Text="Moins de programmes au démarrage = un PC qui démarre plus vite. Rien n'est supprimé, vous pouvez les réactiver à tout moment."/>
            </StackPanel>
            <Button Grid.Column="1" Content="Actualiser" Style="{StaticResource SecondaryButton}" VerticalAlignment="Top" Margin="20,4,0,0" Click="Refresh_Click"/>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="EmptyText" Text="Aucun programme au démarrage." Style="{StaticResource Muted}" Visibility="Collapsed"/>
                <ItemsControl x:Name="List">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,20,0">
                                        <WrapPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                            <Border Background="#252A37" CornerRadius="5" Padding="7,1">
                                                <TextBlock Text="{Binding Location}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                            </Border>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding Command}" Style="{StaticResource Muted}" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" Margin="0,4,0,0" ToolTip="{Binding Command}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                              IsChecked="{Binding IsEnabled, Mode=OneWay}" Click="Toggle_Click"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
